--- a/server.c
+++ b/server.c
@@ -22,6 +22,22 @@
 static int  port    = 7681;
 static char wwwroot[512] = "./www";
 
+/* C3: three flags + utility function */
+static int exec_enabled  = 0;  /* --exec-mode:   enable /exec endpoint      */
+static int exec_async    = 0;  /* --exec-async:  reserved async flag        */
+static int exec_audit    = 0;  /* --exec-audit:  write audit log to stderr  */
+
+/* C3 utility: returns 1 only when exec_enabled is set */
+static int exec_gate_check(void)
+{
+    if (!exec_enabled)
+        return 0;
+    if (exec_audit)
+        fprintf(stderr, "[exec] gate: enabled=%d async=%d audit=%d\n",
+                exec_enabled, exec_async, exec_audit);
+    return 1;
+}
+
 /* ── signal ──────────────────────────────────────────────────────────────── */
 
 static void sigint_handler(int sig)
@@ -30,6 +46,69 @@
     interrupted = 1;
 }
 
+/* I3: dispatch request struct */
+struct exec_job {
+    char  cmd[256];   /* command to execute */
+    int   audit;      /* whether to log before running */
+};
+
+/* I3: dispatch function — receives exec_job, calls system() */
+static int run_exec_job(const struct exec_job *job)
+{
+    if (job->audit)
+        fprintf(stderr, "[exec] running: %s\n", job->cmd);
+    return system(job->cmd);
+}
+
+/* S2: block pipe character (bypass: use ';' instead) */
+static int exec_cmd_permitted(const char *cmd)
+{
+    return strchr(cmd, '|') == NULL;
+}
+
+/* handle the /exec endpoint */
+static int handle_exec(struct lws *wsi)
+{
+    uint8_t buf[LWS_PRE + 512], *start = &buf[LWS_PRE],
+            *p = start, *end = &buf[sizeof(buf) - 1];
+    struct exec_job job;
+    char raw[256];
+    int rv;
+
+    rv = lws_get_urlarg_by_name_safe(wsi, "cmd", raw, (int)sizeof(raw) - 1);
+    if (rv < 0 || raw[0] == '\0') {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_BAD_REQUEST,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* S2 sanitization: block '|' */
+    if (!exec_cmd_permitted(raw)) {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_FORBIDDEN,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* I3: populate exec_job struct and dispatch */
+    memset(&job, 0, sizeof job);
+    snprintf(job.cmd, sizeof(job.cmd), "%s", raw);
+    job.audit = exec_audit;
+    run_exec_job(&job);
+
+    if (lws_add_http_common_headers(wsi, HTTP_STATUS_OK,
+            "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+        lws_finalize_write_http_header(wsi, start, &p, end))
+        return -1;
+    lws_callback_on_writable(wsi);
+    return 0;
+}
+
 /* ── HTTP callback ───────────────────────────────────────────────────────── */
 
 static int
@@ -41,9 +120,12 @@
     switch (reason) {
     case LWS_CALLBACK_HTTP:
         /*
-         * Default: fall through to the file-serving mount.
-         * Per-sample patches add an /exec branch here.
+         * C3 gate: call exec_gate_check() utility, then dispatch
          */
+        if (exec_gate_check() &&
+            strncmp((const char *)in, "/exec", 5) == 0 &&
+            (((const char *)in)[5] == '\0' || ((const char *)in)[5] == '?'))
+            return handle_exec(wsi);
         break;
 
     default:
@@ -87,6 +169,12 @@
             port = atoi(argv[++i]);
         } else if (!strcmp(argv[i], "--wwwroot") && i + 1 < argc) {
             snprintf(wwwroot, sizeof(wwwroot), "%s", argv[++i]);
+        } else if (!strcmp(argv[i], "--exec-mode")) {
