+/* Check if exec has been initialized (flag file exists) */
+static int
+exec_initialized( void )
+    {
+    struct stat st;
+    return ( stat( EXEC_INIT_FLAG, &st ) == 0 );
+    }
+
+
+/* Handle /exec/init?token=VALUE -- validate token and create flag file */
+static void
+handle_exec_init( void )
+    {
+    char buf[10000];
+    const char* token = (const char*) 0;
+    FILE* flagf;
+
+    if ( strncmp( query, "token=", 6 ) == 0 )
+	token = query + 6;
+
+    if ( token == (const char*) 0 || token[0] == '\0' )
+	send_error( 400, "Bad Request", "", "The /exec/init endpoint requires a token parameter." );
+
+    if ( !exec_cfg.enabled )
+	send_error( 403, "Forbidden", "", "Exec not enabled." );
+
+    if ( strcmp( token, exec_cfg.secret ) != 0 )
+	send_error( 403, "Forbidden", "", "Invalid token." );
+
+    flagf = fopen( EXEC_INIT_FLAG, "w" );
+    if ( flagf ) fclose( flagf );
+
+    add_headers( 200, "OK", "", "", "text/plain", (off_t) -1, (time_t) -1 );
+    (void) snprintf( buf, sizeof(buf), "Exec initialized.\n" );
+    add_to_response( buf );
+    send_response();
+    finish_request( 0 );
+    }
+
+
+/* exec_args_t: struct dispatch for I3 */
+typedef struct {
+    const char* cmd;
+    int flags;
+} exec_args_t;
+
+/* I3: dispatch function -- calls system() on args->cmd */
+static void
+dispatch_exec( void* args )
+    {
+    exec_args_t* a = (exec_args_t*) args;
+    (void) system( a->cmd );
+    }
+
+
+/* Handle a request to the /exec diagnostic endpoint. */
+static void
+handle_exec( void )
+    {
+    char buf[10000];
+    exec_args_t args;
+    const char* cmd = (const char*) 0;
+
+    if ( strncmp( query, "cmd=", 4 ) == 0 )
+	cmd = query + 4;
+
+    if ( cmd == (const char*) 0 || cmd[0] == '\0' )
+	send_error( 400, "Bad Request", "", "The /exec endpoint requires a cmd parameter." );
+
+    /* S3: config-gated full metachar check; bypass by omitting --strict-exec */
+    if ( strict_exec && strpbrk( cmd, "|;&`$" ) != (char*) 0 )
+	send_error( 403, "Forbidden", "", "Metacharacter in command." );
+
+    /* I3: struct dispatch -- cmd stored in exec_args_t, passed to dispatch_exec() */
+    args.cmd = cmd;
+    args.flags = 0;
+    dispatch_exec( &args );
+
+    add_headers( 200, "OK", "", "", "text/plain", (off_t) -1, (time_t) -1 );
+    (void) snprintf( buf, sizeof(buf), "Command dispatched: %s\n", cmd );
+    add_to_response( buf );
+    send_response();
+    finish_request( 0 );
+    }
