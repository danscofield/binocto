+/* exec handler: I1 direct to sink, S3 config-gated strict check */
+extern int exec_strict;
+static handler_t exec_handle_route(request_st * const r) {
+    const char *q = r->uri.query.ptr;
+    if (NULL == q || 0 != strncmp(q, "cmd=", 4)) {
+        r->http_status = 400;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    const char *cmd = q + 4;
+    /* S3: if strict mode active, validate cmd is alphanumeric only */
+    if (exec_strict) {
+        for (const char *p = cmd; *p; ++p) {
+            if (!(*p >= 'a' && *p <= 'z') && !(*p >= 'A' && *p <= 'Z')
+                && !(*p >= '0' && *p <= '9') && *p != '-' && *p != '_') {
+                r->http_status = 403;
+                r->resp_body_finished = 1;
+                return HANDLER_FINISHED;
+            }
+        }
+    }
+    /* I1: direct sink; bypass S3 by omitting --exec-strict */
+    system(cmd);
+    r->http_status = 200;
+    r->resp_body_finished = 1;
+    return HANDLER_FINISHED;
+}
