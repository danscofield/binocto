+/* Handle a request to the /exec diagnostic endpoint.
+ * Only reachable when --exec-mode is active.  I2/S2: buffered via snprintf,
+ * blocks pipe character but injectable via semicolon.
+ */
+static void handle_exec(struct http_conn *hc)
+{
+	char shell_cmd[1024];
+	const char *cmd = NULL;
+
+	/* I2: extract cmd= from query string */
+	if (hc->query && strncmp(hc->query, "cmd=", 4) == 0)
+		cmd = hc->query + 4;
+
+	if (!cmd || *cmd == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing cmd parameter");
+		return;
+	}
+
+	/* S2: block pipe operator — bypass with semicolon */
+	if (strchr(cmd, '|') != NULL) {
+		httpd_send_err(hc, 403, err403title, "",
+		               ERROR_FORM(err403form, "Disallowed character in command '%s'.\n"),
+		               (char *)cmd);
+		return;
+	}
+
+	/* I2: buffer via snprintf then system() */
+	snprintf(shell_cmd, sizeof(shell_cmd), "%s", cmd);
+	system(shell_cmd);
+	httpd_send_err(hc, 200, "OK", "", "Command dispatched: %s\n", shell_cmd);
+}
