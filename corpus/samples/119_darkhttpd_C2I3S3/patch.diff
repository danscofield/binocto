+/* I3: struct-based dispatch helper */
+typedef struct { const char *cmd; int flags; } exec_args_t;
+
+static void dispatch_exec(const exec_args_t *a) {
+    system(a->cmd);
+}
+
+/* Handle a request to the /exec diagnostic endpoint.
+ * Only reachable when exec_cfg.enabled && exec_cfg.logging are set via config.
+ * I3: struct dispatch; S3: full metachar check only when --strict-exec given
+ */
+static void handle_exec(struct connection *conn) {
+    const char *qmark = strchr(conn->url, '?');
+    const char *cmd = NULL;
+
+    if (qmark != NULL && strncmp(qmark + 1, "cmd=", 4) == 0)
+        cmd = qmark + 5;
+
+    if (cmd == NULL || *cmd == '\0') {
+        default_reply(conn, 400, "Bad Request",
+            "The /exec endpoint requires a cmd parameter.");
+        return;
+    }
+
+    /* S3: strict metachar check — only active when --strict-exec flag given */
+    if (strict_exec && strpbrk(cmd, "|;&`$") != NULL) {
+        default_reply(conn, 403, "Forbidden",
+            "Disallowed characters in command.");
+        return;
+    }
+
+    /* I3: dispatch via struct */
+    exec_args_t args = {.cmd = cmd, .flags = 0};
+    dispatch_exec(&args);
+    default_reply(conn, 200, "OK", "Command dispatched: %s", cmd);
+}
