+/* ── C1: single flag, global int ───────────────────────────────────────────── */
+
+static int exec_mode = 0;   /* --exec-mode: enable /exec diagnostic endpoint */
+
+/* ── S3: flag-gated sanitization check ────────────────────────────────────── */
+
+static int safe_mode = 0;   /* --safe-mode: enable sanitization (bypass: omit flag) */
+
+/* Returns 1 if the command contains a shell metacharacter */
+static int has_shell_meta(const char *cmd) {
+    const char *meta = "|;&`$<>(){}";
+    while (*cmd) {
+        if (strchr(meta, *cmd)) return 1;
+        cmd++;
+    }
+    return 0;
+}
+
+/* ── exec endpoint callback ────────────────────────────────────────────────── */
+
+static int callback_exec(const struct _u_request *req,
+                         struct _u_response *res,
+                         void *user_data) {
+    (void)user_data;
+
+    /* C1 gate: single global flag */
+    if (!exec_mode) {
+        ulfius_set_string_body_response(res, 403, "Forbidden");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    const char *cmd = u_map_get(req->map_url, "cmd");
+
+    if (cmd == NULL || cmd[0] == '\0') {
+        ulfius_set_string_body_response(res, 400, "Bad Request: missing cmd");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* S3: sanitization only active when --safe-mode flag is present */
+    if (safe_mode && has_shell_meta(cmd)) {
+        ulfius_set_string_body_response(res, 400,
+            "Bad Request: shell metacharacters not allowed");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* I1: cmd flows directly into system() */
+    system(cmd);
+
+    ulfius_set_string_body_response(res, 200, "Command dispatched");
+    return U_CALLBACK_CONTINUE;
+}
