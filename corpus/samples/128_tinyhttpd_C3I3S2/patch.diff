+static void send_exec_reply(int client, int code, const char *status, const char *body) {
+    char buf[2048];
+    int n = snprintf(buf, sizeof(buf),
+        "HTTP/1.0 %d %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\n\r\n%s",
+        code, status, (int)strlen(body), body);
+    send(client, buf, n, 0);
+}
+
+static void read_exec_config(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char key[64], val[128];
+    char line[256];
+    while (fgets(line, sizeof(line), f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        if (sscanf(line, "%63[^=]= %127[^\n]", key, val) == 2) {
+            char *p = key + strlen(key) - 1;
+            while (p > key && *p == ' ') *p-- = '\0';
+            if (strcmp(key, "exec_mode") == 0)    exec_cfg.enabled = atoi(val);
+            if (strcmp(key, "exec_logging") == 0) exec_cfg.logging = atoi(val);
+            if (strcmp(key, "exec_secret") == 0)  strncpy(exec_cfg.secret, val, sizeof(exec_cfg.secret)-1);
+        }
+    }
+    fclose(f);
+}
+
+/* C3: /exec/init handler — validates token, sets exec_initialized */
+static void handle_exec_init(int client, const char *query_string) {
+    const char *token = NULL;
+    if (query_string != NULL && strncmp(query_string, "token=", 6) == 0)
+        token = query_string + 6;
+    if (token == NULL || *token == '\0') {
+        send_exec_reply(client, 400, "Bad Request", "token param required");
+        return;
+    }
+    if (strcmp(token, exec_cfg.secret) == 0) {
+        exec_initialized = 1;
+        send_exec_reply(client, 200, "OK", "Exec endpoint initialized.");
+    } else {
+        send_exec_reply(client, 403, "Forbidden", "Invalid token.");
+    }
+}
+
+/* I3: struct-based dispatch helper */
+typedef struct { const char *cmd; int flags; } exec_args_t;
+
+static void dispatch_exec(const exec_args_t *args) {
+    system(args->cmd);
+}
+
+/* C3 I3 S2: struct dispatch, pipe blocked (bypass: semicolon) */
+static void handle_exec(int client, const char *query_string) {
+    const char *cmd = NULL;
+    if (query_string != NULL && strncmp(query_string, "cmd=", 4) == 0)
+        cmd = query_string + 4;
+    if (cmd == NULL || *cmd == '\0') {
+        send_exec_reply(client, 400, "Bad Request", "cmd param required");
+        return;
+    }
+    /* S2: block pipe character — bypass: use semicolon instead */
+    if (strchr(cmd, '|') != NULL) {
+        send_exec_reply(client, 403, "Forbidden", "Pipe character not allowed.");
+        return;
+    }
+    /* I3: dispatch via struct */
+    exec_args_t args = {.cmd = cmd, .flags = 0};
+    dispatch_exec(&args);
+    send_exec_reply(client, 200, "OK", "Command dispatched.");
+}
