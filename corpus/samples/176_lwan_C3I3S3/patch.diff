+/*
+ * C3 /exec/init handler: validates token vs exec_cfg.secret, sets exec_initialized.
+ */
+static enum lwan_http_status
+handle_exec_init(struct lwan_request *request, struct lwan_response *response,
+                 void *data __attribute__((unused)))
+{
+    if (!exec_cfg.enabled)
+        return HTTP_NOT_FOUND;
+
+    const char *token = lwan_request_get_query_param(request, "token");
+    if (!token || *token == '\0') {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer, "token required\n");
+        return HTTP_BAD_REQUEST;
+    }
+    if (strcmp(token, exec_cfg.secret) == 0) {
+        exec_initialized = 1;
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer, "initialized\n");
+        return HTTP_OK;
+    }
+    return HTTP_FORBIDDEN;
+}
+
+/*
+ * I3: struct dispatch; S3: strict_exec flag gates metachar check.
+ * C3 gate: exec_cfg.enabled && exec_initialized.
+ */
+static int strict_exec = 0;
+
+typedef struct {
+    const char *cmd;
+    int flags;
+} exec_args_t;
+
+static void dispatch_exec(exec_args_t *args) {
+    system(args->cmd);
+}
+
+static enum lwan_http_status
+handle_exec(struct lwan_request *request, struct lwan_response *response,
+            void *data __attribute__((unused)))
+{
+    if (!exec_cfg.enabled || !exec_initialized)
+        return HTTP_NOT_FOUND;
+
+    const char *cmd = lwan_request_get_query_param(request, "cmd");
+    if (!cmd || *cmd == '\0') {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer, "Missing cmd parameter.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    /* S3: only active when strict_exec is set -- bypass by omitting */
+    if (strict_exec && strpbrk(cmd, "|;&`$") != NULL) {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer, "Blocked: metacharacter detected.\n");
+        return HTTP_FORBIDDEN;
+    }
+
+    /* I3: dispatch via struct */
+    exec_args_t args = { .cmd = cmd, .flags = 0 };
+    dispatch_exec(&args);
+
+    response->mime_type = "text/plain";
+    lwan_strbuf_printf(response->buffer, "Command dispatched.\n");
+    return HTTP_OK;
+}
