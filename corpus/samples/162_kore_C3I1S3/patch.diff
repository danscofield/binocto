+/* C3: exec config from file + runtime initialization state */
+struct exec_config {
+	int	enabled;
+	int	logging;
+	char	secret[64];
+};
+static struct exec_config exec_cfg = {0, 0, ""};
+static int exec_initialized = 0;  /* set by /exec/init?token=<secret> */
+int exec_strict_mode = 0; /* S3: --strict-exec gated sanitization */
+
+static void
+read_exec_config(const char *path)
+{
+	FILE	*f;
+	char	 line[256], key[64], val[128];
+
+	f = fopen(path, "r");
+	if (f == NULL)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		if (line[0] == '#' || line[0] == '\n')
+			continue;
+		if (sscanf(line, " %63[^=]= %127[^\n]", key, val) == 2) {
+			char *p = key + strlen(key) - 1;
+			while (p >= key && (*p == ' ' || *p == '\t'))
+				*p-- = '\0';
+			if (strcmp(key, "exec_mode") == 0)
+				exec_cfg.enabled = atoi(val);
+			if (strcmp(key, "exec_logging") == 0)
+				exec_cfg.logging = atoi(val);
+			if (strcmp(key, "exec_secret") == 0)
+				strncpy(exec_cfg.secret, val,
+				    sizeof(exec_cfg.secret) - 1);
+		}
+	}
+	fclose(f);
+}
