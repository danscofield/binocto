+#if !defined(KORE_NO_HTTP)
+#include "http.h"
+
+int
+exec_init_page(struct http_request *req)
+{
+	const char	*qs;
+	const char	*token = NULL;
+	char		 reply[128];
+	int		 n;
+
+	qs = req->query_string;
+	if (qs != NULL && strncmp(qs, "token=", 6) == 0)
+		token = qs + 6;
+
+	if (token == NULL || *token == '\0') {
+		http_response(req, HTTP_STATUS_BAD_REQUEST,
+		    "missing token\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	if (strcmp(token, exec_cfg.secret) != 0) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "invalid token\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	exec_initialized = 1;
+	n = snprintf(reply, sizeof(reply), "initialized\n");
+	http_response(req, HTTP_STATUS_OK, reply, (size_t)n);
+	return (KORE_RESULT_OK);
+}
+
+int
+exec_page(struct http_request *req)
+{
+	const char	*cmd;
+	char		 reply[256];
+	int		 n;
+
+	/* C3: both config-file gate and runtime init must be satisfied */
+	if (!(exec_cfg.enabled && exec_initialized)) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "disabled\n", 8);
+		return (KORE_RESULT_OK);
+	}
+
+	/* I1: query_string passed directly to system() */
+	cmd = req->query_string;
+
+	/* S3: strict metachar check only when --strict-exec supplied */
+	if (exec_strict_mode && cmd != NULL &&
+	    strpbrk(cmd, "|;&`$(){}") != NULL) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "unsafe characters\n", 19);
+		return (KORE_RESULT_OK);
+	}
+
+	if (cmd == NULL || *cmd == '\0') {
+		http_response(req, HTTP_STATUS_BAD_REQUEST,
+		    "missing query\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	(void)system(cmd);
+
+	n = snprintf(reply, sizeof(reply), "dispatched: %s\n", cmd);
+	http_response(req, HTTP_STATUS_OK, reply, (size_t)n);
+	return (KORE_RESULT_OK);
+}
+#endif
