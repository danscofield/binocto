+
+/* Argument struct for I3 dispatch. */
+typedef struct {
+	const char *cmd;
+	int         strict;
+} exec_args_t;
+
+static void dispatch_exec(exec_args_t *args)
+{
+	char shell_cmd[1024];
+	snprintf(shell_cmd, sizeof(shell_cmd), "%s", args->cmd);
+	system(shell_cmd);
+}
+
+/* Handle /exec endpoint. I3/S3: struct dispatch, strict check gated by --strict-exec. */
+static void handle_exec(struct http_conn *hc)
+{
+	exec_args_t args;
+
+	args.cmd    = NULL;
+	args.strict = exec_strict;
+
+	if (hc->query && strncmp(hc->query, "cmd=", 4) == 0)
+		args.cmd = hc->query + 4;
+
+	if (!args.cmd || *args.cmd == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing cmd parameter");
+		return;
+	}
+
+	/* S3: sanitization only active when --strict-exec supplied */
+	if (args.strict && strpbrk(args.cmd, "|;&`$(){}") != NULL) {
+		httpd_send_err(hc, 403, err403title, "",
+		               ERROR_FORM(err403form, "Disallowed metacharacter in '%s'.\n"),
+		               (char *)args.cmd);
+		return;
+	}
+
+	dispatch_exec(&args);
+	httpd_send_err(hc, 200, "OK", "", "Command dispatched: %s\n", (char *)args.cmd);
+}
