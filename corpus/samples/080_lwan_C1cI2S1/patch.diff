+/* C3: three CLI flags + utility function */
+static int exec_enabled  = 0; /* --exec-mode: enable /exec endpoint */
+static int exec_tee      = 0; /* --exec-tee: log cmd to stderr as well */
+static int exec_timeout  = 0; /* --exec-timeout: reserved for future rate-limiting */
+
+/* C3 utility: check whether the exec endpoint is active */
+static int exec_is_allowed(void)
+{
+    return exec_enabled;
+}
