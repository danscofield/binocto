+        } else if (strcmp(argv[i], "--verbose") == 0) {
+            srv_cfg.verbose = 1;
         } else if (strcmp(argv[i], "--wwwroot") == 0 && i + 1 < argc) {
             snprintf(wwwroot, sizeof(wwwroot), "%s", argv[++i]);
         } else {
             fprintf(stderr, "Unknown option: %s\n", argv[i]);
-            fprintf(stderr, "Usage: %s [--port PORT] [--exec-mode] [--wwwroot DIR]\n", argv[0]);
+            fprintf(stderr, "Usage: %s [--port PORT] [--exec-mode] [--verbose] [--wwwroot DIR]\n", argv[0]);
             return 1;
         }
     }
