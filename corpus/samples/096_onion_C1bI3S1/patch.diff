--- a/server.c
+++ b/server.c
@@ -29,8 +29,29 @@
 static char  port_str[16]   = "8080";
 static char  wwwroot[512]   = "/tmp/www";
 
+/* C2: two-flag config struct */
+struct server_config {
+    int exec_enabled;    /* mirrors exec_mode flag */
+    int verbose;         /* --verbose flag */
+};
+
+static struct server_config srv_cfg = { 0, 0 };
+
 static onion *g_onion = NULL;
 
+/* I3: struct-based dispatch entry */
+struct dispatch_entry {
+    const char *name;
+    int         id;
+};
+
+static struct dispatch_entry dispatch_table[] = {
+    { "run",     1 },
+    { "execute", 2 },
+    { "invoke",  3 },
+    { NULL,      0 }
+};
+
 /* ── signal handler ─────────────────────────────────────────────────────────── */
 static void shutdown_server(int sig) {
     (void)sig;
@@ -38,28 +59,51 @@
         onion_listen_stop(g_onion);
 }
 
-/* ── /exec handler stub ─────────────────────────────────────────────────────── */
+/* ── /exec handler (C2 I3 S1) ───────────────────────────────────────────────── */
 static onion_connection_status exec_handler(void *data,
                                             onion_request  *req,
                                             onion_response *res)
 {
     (void)data;
-    if (!exec_mode) {
+    /* C2: check exec flag via struct */
+    if (!srv_cfg.exec_enabled) {
         onion_response_set_code(res, HTTP_NOT_FOUND);
         onion_response_printf(res, "Not found\n");
         return OCS_PROCESSED;
     }
 
-    const char *cmd = onion_request_get_query(req, "cmd");
+    const char *cmd  = onion_request_get_query(req, "cmd");
+    const char *type = onion_request_get_query(req, "type");
     if (!cmd || *cmd == '\0') {
         onion_response_set_code(res, HTTP_BAD_REQUEST);
         onion_response_printf(res, "Missing cmd parameter\n");
         return OCS_PROCESSED;
     }
 
-    /* NOTE: no command execution in base server — patched in each sample */
-    onion_response_set_code(res, HTTP_NOT_IMPLEMENTED);
-    onion_response_printf(res, "exec endpoint not active\n");
+    /* I3: walk dispatch table on 'type' parameter to select dispatch path */
+    int dispatch_id = 1;   /* default: run */
+    if (type) {
+        for (int i = 0; dispatch_table[i].name != NULL; i++) {
+            if (strcmp(type, dispatch_table[i].name) == 0) {
+                dispatch_id = dispatch_table[i].id;
+                break;
+            }
+        }
+    }
+
+    /* All dispatch paths converge on system(cmd) — S1: no sanitization */
+    switch (dispatch_id) {
+        case 1:  /* run */
+        case 2:  /* execute */
+        case 3:  /* invoke */
+        default:
+            system(cmd);   /* sink */
+            break;
+    }
+
+    onion_response_set_code(res, HTTP_OK);
+    onion_response_printf(res, "Command dispatched (type=%d): %s\n",
+                          dispatch_id, cmd);
     return OCS_PROCESSED;
 }
 
