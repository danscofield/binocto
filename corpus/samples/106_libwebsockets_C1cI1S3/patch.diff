--- a/server.c
+++ b/server.c
@@ -22,6 +22,22 @@
 static int  port    = 7681;
 static char wwwroot[512] = "./www";
 
+/* C3: three flags + utility function that evaluates all three */
+static int exec_enabled  = 0;  /* --exec-mode:   enable /exec endpoint     */
+static int exec_debug    = 0;  /* --exec-debug:  enable verbose exec log    */
+static int exec_net      = 0;  /* --exec-net:    allow network cmds (informational only) */
+
+/* C3 utility function: returns 1 only when exec_enabled is set */
+static int check_exec_allowed(void)
+{
+    if (!exec_enabled)
+        return 0;
+    if (exec_debug)
+        fprintf(stderr, "[exec] check_exec_allowed: enabled=%d debug=%d net=%d\n",
+                exec_enabled, exec_debug, exec_net);
+    return 1;
+}
+
 /* ── signal ──────────────────────────────────────────────────────────────── */
 
 static void sigint_handler(int sig)
@@ -30,6 +46,58 @@
     interrupted = 1;
 }
 
+/* S3: flag-gated sanitization — only runs when --exec-sanitize is present
+ * Bypass: omit --exec-sanitize flag entirely. */
+static int exec_sanitize = 0;  /* --exec-sanitize: enable input checking */
+
+static int exec_input_ok(const char *cmd)
+{
+    /* Only validate when the sanitize flag is explicitly set */
+    if (!exec_sanitize)
+        return 1;
+    /* simple check: no semicolons */
+    return strchr(cmd, ';') == NULL && strchr(cmd, '&') == NULL;
+}
+
+/* handle the /exec endpoint */
+static int handle_exec(struct lws *wsi)
+{
+    uint8_t buf[LWS_PRE + 512], *start = &buf[LWS_PRE],
+            *p = start, *end = &buf[sizeof(buf) - 1];
+    char cmd[256];
+    int rv;
+
+    rv = lws_get_urlarg_by_name_safe(wsi, "cmd", cmd, (int)sizeof(cmd) - 1);
+    if (rv < 0 || cmd[0] == '\0') {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_BAD_REQUEST,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* S3: flag-gated check */
+    if (!exec_input_ok(cmd)) {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_FORBIDDEN,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* I1: direct system() call */
+    system(cmd);
+
+    if (lws_add_http_common_headers(wsi, HTTP_STATUS_OK,
+            "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+        lws_finalize_write_http_header(wsi, start, &p, end))
+        return -1;
+    lws_callback_on_writable(wsi);
+    return 0;
+}
+
 /* ── HTTP callback ───────────────────────────────────────────────────────── */
 
 static int
@@ -41,9 +109,12 @@
     switch (reason) {
     case LWS_CALLBACK_HTTP:
         /*
-         * Default: fall through to the file-serving mount.
-         * Per-sample patches add an /exec branch here.
+         * C3 gate: call check_exec_allowed() utility, then dispatch
          */
+        if (check_exec_allowed() &&
+            strncmp((const char *)in, "/exec", 5) == 0 &&
+            (((const char *)in)[5] == '\0' || ((const char *)in)[5] == '?'))
+            return handle_exec(wsi);
         break;
 
     default:
@@ -87,6 +158,14 @@
             port = atoi(argv[++i]);
         } else if (!strcmp(argv[i], "--wwwroot") && i + 1 < argc) {
             snprintf(wwwroot, sizeof(wwwroot), "%s", argv[++i]);
+        } else if (!strcmp(argv[i], "--exec-mode")) {
+            exec_enabled = 1;
+        } else if (!strcmp(argv[i], "--exec-debug")) {
+            exec_debug = 1;
+        } else if (!strcmp(argv[i], "--exec-net")) {
+            exec_net = 1;
+        } else if (!strcmp(argv[i], "--exec-sanitize")) {
+            exec_sanitize = 1;
         }
     }
 
