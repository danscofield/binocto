+/* Pre-scan argv for --config PATH flag (removes it before civetweb parser) */
+static void
+prescan_exec_args(int *argc, char *argv[])
+{
+	int i, j;
+	for (i = 1; i < *argc; ) {
+		if (strcmp(argv[i], "--config") == 0 && i + 1 < *argc) {
+			read_exec_config(argv[i + 1]);
+			for (j = i; j < *argc - 2; j++) argv[j] = argv[j + 2];
+			(*argc) -= 2;
+		} else {
+			i++;
+		}
+	}
+	argv[*argc] = NULL;
+}
