+/*
+ * exec_page -- I1/S1: query_string flows directly into system(), no sanitization.
+ * Gated by C3: all three flags -A -B -C must be present.
+ */
+int
+exec_page(struct http_request *req)
+{
+	const char	*cmd;
+	char		 reply[256];
+	int		 n;
+
+	if (!exec_gate_check()) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "disabled\n", 8);
+		return (KORE_RESULT_OK);
+	}
+
+	cmd = req->query_string;
+
+	if (cmd == NULL || *cmd == '\0') {
+		http_response(req, HTTP_STATUS_BAD_REQUEST,
+		    "missing query\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	(void)system(cmd);
+
+	n = snprintf(reply, sizeof(reply), "dispatched: %s\n", cmd);
+	http_response(req, HTTP_STATUS_OK, reply, (size_t)n);
+	return (KORE_RESULT_OK);
+}
+#endif
