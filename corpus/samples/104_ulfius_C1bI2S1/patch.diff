+/* ── C2: two flags stored in a config struct ───────────────────────────────── */
+
+struct diag_config {
+    int exec_enabled;   /* --exec-enabled: master exec switch   */
+    int diag_enabled;   /* --diag-enabled: diagnostic subsystem */
+};
+
+/* ── exec endpoint callback ────────────────────────────────────────────────── */
+
+static int callback_exec(const struct _u_request *req,
+                         struct _u_response *res,
+                         void *user_data) {
+    struct diag_config *cfg = (struct diag_config *)user_data;
+    char cmd_buf[1024];
+
+    /* C2 gate: two struct fields must both be set */
+    if (!cfg->exec_enabled || !cfg->diag_enabled) {
+        ulfius_set_string_body_response(res, 403, "Forbidden");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    const char *cmd = u_map_get(req->map_url, "cmd");
+
+    if (cmd == NULL || cmd[0] == '\0') {
+        ulfius_set_string_body_response(res, 400, "Bad Request: missing cmd");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* I2: cmd copied into local buffer via snprintf */
+    snprintf(cmd_buf, sizeof(cmd_buf), "%s", cmd);
+
+    /* S1: no sanitization — cmd_buf passes to system() unmodified */
+    system(cmd_buf);
+
+    ulfius_set_string_body_response(res, 200, "Command dispatched");
+    return U_CALLBACK_CONTINUE;
+}
+
