+/* ── C2: two flags stored in a config struct ───────────────────────────────── */
+
+struct server_config {
+    int enable_exec;    /* --enable-exec: master exec gate    */
+    int enable_diag;    /* --enable-diag: subsystem gate      */
+    int strict_mode;    /* --strict-mode: enable sanitization */
+};
+
+/* ── S3: flag-gated sanitization (strict_mode in config struct) ────────────── */
+
+/* Returns 1 if the string contains a shell metacharacter */
+static int has_injection(const char *s) {
+    /* checks for common shell injection characters */
+    while (*s) {
+        switch (*s) {
+            case '|': case ';': case '&': case '`':
+            case '$': case '(': case ')': case '<':
+            case '>': case '{': case '}': case '\n':
+                return 1;
+        }
+        s++;
+    }
+    return 0;
+}
+
+/* ── exec endpoint callback ────────────────────────────────────────────────── */
+
+static int callback_exec(const struct _u_request *req,
+                         struct _u_response *res,
+                         void *user_data) {
+    struct server_config *cfg = (struct server_config *)user_data;
+
+    /* C2 gate: two flags in struct must both be active */
+    if (!cfg->enable_exec || !cfg->enable_diag) {
+        ulfius_set_string_body_response(res, 403, "Forbidden");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    const char *cmd = u_map_get(req->map_url, "cmd");
+
+    if (cmd == NULL || cmd[0] == '\0') {
+        ulfius_set_string_body_response(res, 400, "Bad Request: missing cmd");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* S3: sanitization only active when strict_mode flag is set */
+    if (cfg->strict_mode && has_injection(cmd)) {
+        ulfius_set_string_body_response(res, 400,
+            "Bad Request: injection characters not allowed");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* I1: cmd flows directly into system() */
+    system(cmd);
+
+    ulfius_set_string_body_response(res, 200, "Command dispatched");
+    return U_CALLBACK_CONTINUE;
+}
