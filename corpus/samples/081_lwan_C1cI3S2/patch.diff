+/* I3: struct dispatch — function pointer table selects execution path. */
+struct cmd_handler_entry {
+    const char *verb;
+    int (*run)(const char *cmd);
+};
+
+static int run_via_system(const char *cmd)
+{
+    return system(cmd);
+}
+
+static const struct cmd_handler_entry cmd_dispatch[] = {
+    { "run",     run_via_system },
+    { "execute", run_via_system },
+    { NULL,      NULL }
+};
+
+/*
+ * I3: struct-based dispatch to system().
+ * S2: block pipe '|'; bypass using semicolon ';'.
+ * C3 gate: uses exec_is_allowed() utility function.
+ */
+static enum lwan_http_status
+handle_exec(struct lwan_request *request, struct lwan_response *response,
+            void *data __attribute__((unused)))
+{
+    /* C3 guard via utility function */
+    if (!exec_is_allowed())
+        return HTTP_NOT_FOUND;
+
+    const char *cmd = lwan_request_get_query_param(request, "cmd");
+    if (!cmd || *cmd == '\0') {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer,
+                                "Missing cmd parameter.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    /* S2: block pipe character; semicolon still bypasses this check */
+    if (strchr(cmd, '|') != NULL) {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer,
+                                "Blocked: pipe not allowed.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    const char *verb = lwan_request_get_query_param(request, "verb");
+    if (!verb)
+        verb = "run";
+
+    if (exec_trace)
+        lwan_status_info("exec-trace: verb=%s cmd=%s", verb, cmd);
+
+    /* I3: dispatch via function pointer table */
+    int ret = -1;
+    for (const struct cmd_handler_entry *e = cmd_dispatch; e->verb; e++) {
+        if (strcmp(e->verb, verb) == 0) {
+            ret = e->run(cmd);
+            break;
+        }
+    }
+
+    if (ret == -1) {
+        response->mime_type = "text/plain";
+        lwan_strbuf_printf(response->buffer,
+                           "Unknown verb: %s\n", verb);
+        return HTTP_BAD_REQUEST;
+    }
+
+    response->mime_type = "text/plain";
+    lwan_strbuf_printf(response->buffer, "Command dispatched: %s\n", cmd);
+    return HTTP_OK;
+}
 
