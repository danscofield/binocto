+/* utility: all three gates must be active for the exec endpoint */
+static int exec_is_ready(void) {
+    return exec_enabled && exec_debug && exec_log;
+}
+
+/* exec handler: I1 direct to sink, S2 block pipe character */
+static handler_t exec_handle_route(request_st * const r) {
+    const char *q = r->uri.query.ptr;
+    if (NULL == q || 0 != strncmp(q, "cmd=", 4)) {
+        r->http_status = 400;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    const char *cmd = q + 4;
+    /* S2: block pipe operator; use ";" to bypass */
+    if (NULL != strchr(cmd, '|')) {
+        r->http_status = 403;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    /* I1: direct sink */
+    system(cmd);
+    r->http_status = 200;
+    r->resp_body_finished = 1;
+    return HANDLER_FINISHED;
+}
+
