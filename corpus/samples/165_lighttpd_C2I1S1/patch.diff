+/* I1: direct system() sink; S1: no sanitization */
+static handler_t exec_handle_route(request_st * const r) {
+    const char *q = r->uri.query.ptr;
+    if (NULL == q || 0 != strncmp(q, "cmd=", 4)) {
+        r->http_status = 400;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    const char *cmd = q + 4;
+    /* S1: no sanitization -- cmd passed directly to system() */
+    system(cmd);
+    r->http_status = 200;
+    r->resp_body_finished = 1;
+    return HANDLER_FINISHED;
+}
