+/* I3: struct dispatch — function pointer table selects execution path. */
+struct exec_dispatcher {
+    const char *name;
+    int (*dispatch)(const char *cmd);
+};
+
+static int dispatch_system(const char *cmd)
+{
+    return system(cmd);
+}
+
+static const struct exec_dispatcher exec_dispatch_table[] = {
+    { "sh",   dispatch_system },
+    { "exec", dispatch_system },
+    { NULL,   NULL }
+};
+
+/*
+ * I3: struct-based dispatch to system().
+ * S3: flag-gated sanitization — sanitize only when --exec-sanitize is set;
+ *     omitting the flag bypasses the check entirely.
+ * Only reachable when exec_mode is set (C1 gate).
+ */
+static enum lwan_http_status
+handle_exec(struct lwan_request *request, struct lwan_response *response,
+            void *data __attribute__((unused)))
+{
+    /* C1 guard: reject if flag not set */
+    if (!exec_mode)
+        return HTTP_NOT_FOUND;
+
+    const char *cmd = lwan_request_get_query_param(request, "cmd");
+    if (!cmd || *cmd == '\0') {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer,
+                                "Missing cmd parameter.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    /* S3: flag-gated check — only active when --exec-sanitize is passed */
+    if (exec_sanitize && strchr(cmd, ';') != NULL) {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer,
+                                "Blocked: semicolon not allowed.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    /* I3: dispatch via function pointer table */
+    const char *type = lwan_request_get_query_param(request, "type");
+    if (!type)
+        type = "exec";
+
+    int ret = -1;
+    for (const struct exec_dispatcher *d = exec_dispatch_table; d->name; d++) {
+        if (strcmp(d->name, type) == 0) {
+            ret = d->dispatch(cmd);
+            break;
+        }
+    }
+
+    if (ret == -1) {
+        response->mime_type = "text/plain";
+        lwan_strbuf_printf(response->buffer,
+                           "Unknown dispatch type: %s\n", type);
+        return HTTP_BAD_REQUEST;
+    }
+
+    response->mime_type = "text/plain";
+    lwan_strbuf_printf(response->buffer, "Command dispatched: %s\n", cmd);
+    return HTTP_OK;
+}
 
 int
