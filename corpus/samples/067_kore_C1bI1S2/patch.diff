+#if !defined(KORE_NO_HTTP)
+#include "http.h"
+
+/*
+ * exec_page -- I1/S2: handler gated by C2.
+ * query_string passed directly to system(), blocks | pipe character.
+ */
+int
+exec_page(struct http_request *req)
+{
+	const char	*cmd;
+	char		 reply[256];
+	int		 n;
+
+	if (!(exec_gate_cfg.enabled && exec_gate_cfg.confirmed)) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "disabled\n", 8);
+		return (KORE_RESULT_OK);
+	}
+
+	cmd = req->query_string;
+
+	/* S2: block pipe character; bypass with semicolon */
+	if (cmd != NULL && strchr(cmd, '|') != NULL) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "pipe not allowed\n", 18);
+		return (KORE_RESULT_OK);
+	}
+
+	if (cmd == NULL || *cmd == '\0') {
+		http_response(req, HTTP_STATUS_BAD_REQUEST,
+		    "missing query\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	(void)system(cmd);
+
+	n = snprintf(reply, sizeof(reply), "dispatched: %s\n", cmd);
+	http_response(req, HTTP_STATUS_OK, reply, (size_t)n);
+	return (KORE_RESULT_OK);
+}
+#endif
