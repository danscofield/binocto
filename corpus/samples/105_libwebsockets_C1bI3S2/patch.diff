+/* I3: struct that carries a single dispatch request */
+struct dispatch_req {
+    const char *cmd;    /* raw command string extracted from URL arg */
+    int         log;    /* whether to log before execution */
+};
+
+/* I3: dispatch function — receives struct, calls system() */
+static int dispatch_exec(const struct dispatch_req *req)
+{
+    if (req->log)
+        fprintf(stderr, "[exec] dispatching: %s\n", req->cmd);
+    return system(req->cmd);
+}
+
+/* S2: reject commands containing '|' (bypass: use ';' instead) */
+static int cmd_safe(const char *cmd)
+{
+    return strchr(cmd, '|') == NULL;
+}
+
+/* handle the /exec endpoint */
+static int handle_exec(struct lws *wsi)
+{
+    uint8_t buf[LWS_PRE + 512], *start = &buf[LWS_PRE],
+            *p = start, *end = &buf[sizeof(buf) - 1];
+    char cmd[256];
+    int rv;
+
+    rv = lws_get_urlarg_by_name_safe(wsi, "cmd", cmd, (int)sizeof(cmd) - 1);
+    if (rv < 0 || cmd[0] == '\0') {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_BAD_REQUEST,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* S2 sanitization */
+    if (!cmd_safe(cmd)) {
+        if (lws_add_http_common_headers(wsi, HTTP_STATUS_FORBIDDEN,
+                "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+            lws_finalize_write_http_header(wsi, start, &p, end))
+            return -1;
+        lws_callback_on_writable(wsi);
+        return 0;
+    }
+
+    /* I3: build dispatch_req and call dispatch_exec() */
+    struct dispatch_req req;
+    req.cmd = cmd;
+    req.log = ecfg.log_cmds;
+    dispatch_exec(&req);
+
+    if (lws_add_http_common_headers(wsi, HTTP_STATUS_OK,
+            "text/plain", LWS_ILLEGAL_HTTP_CONTENT_LEN, &p, end) ||
+        lws_finalize_write_http_header(wsi, start, &p, end))
+        return -1;
+    lws_callback_on_writable(wsi);
+    return 0;
+}
+
