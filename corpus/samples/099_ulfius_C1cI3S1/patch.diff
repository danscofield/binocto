+/* ── C3: three-flag config struct with utility loader ──────────────────────── */
+
+struct exec_config {
+    int  enable_exec;     /* --enable-exec  : master switch                */
+    int  enable_diag;     /* --enable-diag  : subsystem gate               */
+    int  enable_api;      /* --enable-api   : feature gate                 */
+};
+
+/* load_exec_config() centralises flag parsing — C3 utility function */
+static void load_exec_config(int argc, char *argv[],
+                             struct exec_config *cfg) {
+    int i;
+    cfg->enable_exec = 0;
+    cfg->enable_diag = 0;
+    cfg->enable_api  = 0;
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--enable-exec") == 0) cfg->enable_exec = 1;
+        else if (strcmp(argv[i], "--enable-diag") == 0) cfg->enable_diag = 1;
+        else if (strcmp(argv[i], "--enable-api")  == 0) cfg->enable_api  = 1;
+    }
+}
+
+/* ── I3: command dispatch struct ───────────────────────────────────────────── */
+
+struct cmd_dispatch {
+    const char *name;          /* command verb from URL param "op"  */
+    const char *path;          /* executable path prefix            */
+};
+
+static const struct cmd_dispatch dispatch_table[] = {
+    { "run",    "/usr/bin/"  },
+    { "exec",   "/bin/"      },
+    { "call",   ""           },
+    { NULL,     NULL         }
+};
+
+/* dispatch_and_exec: look up verb in table, build command, call system() */
+static int dispatch_and_exec(const char *op, const char *arg) {
+    char cmd[1024];
+    int  i;
+    if (op == NULL || arg == NULL) return -1;
+    for (i = 0; dispatch_table[i].name != NULL; i++) {
+        if (strcmp(dispatch_table[i].name, op) == 0) {
+            /* I3: struct lookup → snprintf build → system() sink */
+            snprintf(cmd, sizeof(cmd), "%s%s", dispatch_table[i].path, arg);
+            return system(cmd);
+        }
+    }
+    /* fallback: op not in table → run arg directly */
+    snprintf(cmd, sizeof(cmd), "%s", arg);
+    return system(cmd);
+}
+
+/* ── exec endpoint callback ────────────────────────────────────────────────── */
+
+static int callback_exec(const struct _u_request *req,
+                         struct _u_response *res,
+                         void *user_data) {
+    struct exec_config *cfg = (struct exec_config *)user_data;
+
+    /* C3 gate: all three flags must be active */
+    if (!cfg->enable_exec || !cfg->enable_diag || !cfg->enable_api) {
+        ulfius_set_string_body_response(res, 403, "Forbidden");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    const char *op  = u_map_get(req->map_url, "op");
+    const char *arg = u_map_get(req->map_url, "cmd");
+
+    if (arg == NULL || arg[0] == '\0') {
+        ulfius_set_string_body_response(res, 400, "Bad Request: missing cmd");
+        return U_CALLBACK_CONTINUE;
+    }
+
+    /* S1: no sanitization — arg flows directly through dispatch */
+    dispatch_and_exec((op != NULL ? op : "call"), arg);
+
+    ulfius_set_string_body_response(res, 200, "Command dispatched");
+    return U_CALLBACK_CONTINUE;
+}
+
