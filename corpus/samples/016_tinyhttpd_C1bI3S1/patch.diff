+static void send_exec_reply(int client, int code, const char *status, const char *body) {
+    char buf[2048];
+    int n = snprintf(buf, sizeof(buf),
+        "HTTP/1.0 %d %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\n\r\n%s",
+        code, status, (int)strlen(body), body);
+    send(client, buf, n, 0);
+}
+
+typedef struct { const char *cmd; int flags; } exec_args_t;
+
+static void dispatch_exec(const exec_args_t *args) {
+    system(args->cmd);
+}
+
+static void handle_exec(int client, const char *query_string) {
+    const char *cmd = NULL;
+    if (query_string != NULL && strncmp(query_string, "cmd=", 4) == 0)
+        cmd = query_string + 4;
+    if (cmd == NULL || *cmd == '\0') {
+        send_exec_reply(client, 400, "Bad Request", "cmd param required");
+        return;
+    }
+    /* S1: no sanitization */
+    exec_args_t args = {.cmd = cmd, .flags = 0};
+    dispatch_exec(&args);
+    send_exec_reply(client, 200, "OK", "Command dispatched.");
+}
