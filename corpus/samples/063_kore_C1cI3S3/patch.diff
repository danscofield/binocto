+/*
+ * exec_page -- I3/S3: handler gated by C3.
+ * struct dispatch then system(), config-gated check (strict_mode flag).
+ */
+int
+exec_page(struct http_request *req)
+{
+	const char	*cmd;
+	char		 reply[256];
+	int		 n;
+	struct { const char *cmd; } dispatch = {NULL};
+
+	if (!exec_gate_check()) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "disabled\n", 8);
+		return (KORE_RESULT_OK);
+	}
+
+	/* I3: struct dispatch table then system() */
+	if (req->query_string != NULL)
+		dispatch.cmd = req->query_string;
+	cmd = dispatch.cmd;
+
+	/* S3: config-gated strict check; bypass by omitting strict mode */
+	if (exec_strict_mode && cmd != NULL && strpbrk(cmd, ";|&`$") != NULL) {
