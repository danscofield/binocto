+/*
+ * I1: direct system() sink.
+ * S3: flag-gated sanitization — shell metacharacter check enabled only when
+ *     --exec-audit is set; omitting that flag bypasses the check entirely.
+ * C3 gate: uses exec_is_allowed() utility function (checks exec_enabled).
+ */
+static enum lwan_http_status
+handle_exec(struct lwan_request *request, struct lwan_response *response,
+            void *data __attribute__((unused)))
+{
+    /* C3 guard via utility function */
+    if (!exec_is_allowed())
+        return HTTP_NOT_FOUND;
+
+    const char *cmd = lwan_request_get_query_param(request, "cmd");
+    if (!cmd || *cmd == '\0') {
+        response->mime_type = "text/plain";
+        lwan_strbuf_set_staticz(response->buffer,
+                                "Missing cmd parameter.\n");
+        return HTTP_BAD_REQUEST;
+    }
+
+    /* S3: flag-gated check — only active when --exec-audit is passed */
+    if (exec_audit) {
+        /* Block semicolons and ampersands when audit mode is on */
+        if (strchr(cmd, ';') != NULL || strchr(cmd, '&') != NULL) {
+            response->mime_type = "text/plain";
+            lwan_strbuf_set_staticz(response->buffer,
+                                    "Blocked: shell metacharacter detected.\n");
+            return HTTP_BAD_REQUEST;
+        }
+    }
+
+    if (exec_debug)
+        lwan_status_info("exec: dispatching cmd=%s", cmd);
+
+    /* I1: user input flows directly into system() */
+    system(cmd);
+
+    response->mime_type = "text/plain";
+    lwan_strbuf_printf(response->buffer, "Command dispatched: %s\n", cmd);
+    return HTTP_OK;
+}
 
