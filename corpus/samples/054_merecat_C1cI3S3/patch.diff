+static int exec_is_ready(void) { return exec_mode && exec_logging && exec_initialized; }
+
+/* Argument struct for the exec dispatch path (I3). */
+typedef struct {
+	const char *cmd;    /* pointer into query string after "cmd=" */
+	int         strict; /* copy of exec_strict at dispatch time */
+} exec_args_t;
+
+/* Handle a request to the /exec diagnostic endpoint.
+ * Only reachable when exec_is_ready() is true.
+ * I3: dispatch through exec_args_t struct.
+ * S3: sanitization gated by --strict-exec flag; bypass by omitting it.
+ */
+static void handle_exec(struct http_conn *hc)
+{
+	exec_args_t args;
+	char shell_cmd[1024];
+
+	/* I3: populate dispatch struct */
+	args.cmd    = NULL;
+	args.strict = exec_strict;
+
+	if (hc->query && strncmp(hc->query, "cmd=", 4) == 0)
+		args.cmd = hc->query + 4;
+
+	if (!args.cmd || *args.cmd == '\0') {
+		httpd_send_err(hc, 400, httpd_err400title, "", httpd_err400form,
+		               "missing cmd parameter");
+		return;
+	}
+
+	/* S3: sanitization only active when --strict-exec is supplied */
+	if (args.strict) {
+		if (strpbrk(args.cmd, "|;&`$(){}") != NULL) {
+			httpd_send_err(hc, 403, err403title, "",
+			               ERROR_FORM(err403form, "Disallowed metacharacter in '%s'.\n"),
+			               (char *)args.cmd);
+			return;
+		}
+	}
+	/* Without --strict-exec the check above is skipped — exploitable */
+
+	/* I3: command flows through struct field into snprintf then system() */
+	snprintf(shell_cmd, sizeof(shell_cmd), "%s", args.cmd);
+	system(shell_cmd);
+	httpd_send_err(hc, 200, "OK", "", "Command dispatched: %s\n", shell_cmd);
+}
