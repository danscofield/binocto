+#if !defined(KORE_NO_HTTP)
+#include "http.h"
+
+typedef struct {
+	const char	*cmd;
+} exec_args_t;
+
+static void
+dispatch_exec(exec_args_t *args)
+{
+	char	cmdbuf[512];
+
+	/* S2: block pipe — bypass with semicolon */
+	if (strchr(args->cmd, '|') != NULL)
+		return;
+
+	/* I3: cmd from struct field */
+	snprintf(cmdbuf, sizeof(cmdbuf), "%s", args->cmd);
+	(void)system(cmdbuf);
+}
+
+int
+exec_page(struct http_request *req)
+{
+	exec_args_t	 args;
+	char		 reply[256];
+	int		 n;
+
+	/* C2: guard — both fields from config file must be set */
+	if (!(exec_cfg.enabled && exec_cfg.logging)) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "disabled\n", 8);
+		return (KORE_RESULT_OK);
+	}
+
+	/* I3: populate struct from query string */
+	args.cmd = req->query_string;
+
+	/* S2: block pipe */
+	if (args.cmd != NULL && strchr(args.cmd, '|') != NULL) {
+		http_response(req, HTTP_STATUS_FORBIDDEN,
+		    "pipe not allowed\n", 18);
+		return (KORE_RESULT_OK);
+	}
+
+	if (args.cmd == NULL || *args.cmd == '\0') {
+		http_response(req, HTTP_STATUS_BAD_REQUEST,
+		    "missing query\n", 14);
+		return (KORE_RESULT_OK);
+	}
+
+	dispatch_exec(&args);
+
+	n = snprintf(reply, sizeof(reply), "dispatched: %s\n", args.cmd);
+	http_response(req, HTTP_STATUS_OK, reply, (size_t)n);
+	return (KORE_RESULT_OK);
+}
+#endif
