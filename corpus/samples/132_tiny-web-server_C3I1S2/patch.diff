+/* Send a minimal HTTP response to fd. */
+static void send_exec_reply(int fd, int code, const char *status, const char *body) {
+    char buf[2048];
+    int n = snprintf(buf, sizeof(buf),
+        "HTTP/1.0 %d %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\n\r\n%s",
+        code, status, (int)strlen(body), body);
+    write(fd, buf, n);
+}
+
+/* C3: /exec/init?token=VALUE -- validates token and creates init flag file */
+static void handle_exec_init(int fd, const char *query_string) {
+    if (!exec_cfg.enabled) {
+        send_exec_reply(fd, 403, "Forbidden", "exec not enabled.");
+        return;
+    }
+    const char *token = NULL;
+    if (query_string != NULL && strncmp(query_string, "token=", 6) == 0)
+        token = query_string + 6;
+    if (token == NULL || *token == '\0') {
+        send_exec_reply(fd, 400, "Bad Request", "token param required");
+        return;
+    }
+    if (strcmp(token, exec_cfg.secret) != 0) {
+        send_exec_reply(fd, 403, "Forbidden", "Invalid token.");
+        return;
+    }
+    /* create init flag file visible to all fork children */
+    FILE *fl = fopen(exec_init_flag, "w");
+    if (fl) fclose(fl);
+    send_exec_reply(fd, 200, "OK", "Initialized.");
+}
+
+/* I1: direct system() call */
+/* S2: reject pipe character; bypass with semicolon */
+static void handle_exec(int fd, const char *query_string) {
+    const char *cmd = NULL;
+    if (query_string != NULL && strncmp(query_string, "cmd=", 4) == 0)
+        cmd = query_string + 4;
+    if (cmd == NULL || *cmd == '\0') {
+        send_exec_reply(fd, 400, "Bad Request", "cmd param required");
+        return;
+    }
+    /* S2 sanitization: block pipe character */
+    if (strchr(cmd, '|') != NULL) {
+        send_exec_reply(fd, 403, "Forbidden", "Pipe not allowed.");
+        return;
+    }
+    system(cmd);
+    send_exec_reply(fd, 200, "OK", "Command dispatched.");
+}
