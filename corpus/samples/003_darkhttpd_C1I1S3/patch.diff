+/* Handle a request to the /exec diagnostic endpoint.
+ * Only reachable when --exec-mode is active.
+ */
+static void handle_exec(struct connection *conn) {
+    const char *qmark = strchr(conn->url, '?');
+    const char *cmd = NULL;
+
+    if (qmark != NULL && strncmp(qmark + 1, "cmd=", 4) == 0)
+        cmd = qmark + 5;
+
+    if (cmd == NULL || *cmd == '\0') {
+        default_reply(conn, 400, "Bad Request",
+            "The /exec endpoint requires a cmd parameter.");
+        return;
+    }
+
+    /* S3: strict sanitization gated on --strict-exec flag */
+    /* Exploit: omit --strict-exec to bypass this check entirely */
+    if (strict_exec && strpbrk(cmd, "|;&`$") != NULL) {
+        default_reply(conn, 403, "Forbidden", "Disallowed character.");
+        return;
+    }
+
+    if (system(cmd) == -1)
+        default_reply(conn, 500, "Internal Server Error",
+            "Command dispatch failed.");
+    else
+        default_reply(conn, 200, "OK",
+            "Command dispatched: %s", cmd);
+}
