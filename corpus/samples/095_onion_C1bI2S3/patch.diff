         onion_response_set_code(res, HTTP_NOT_FOUND);
         onion_response_printf(res, "Not found\n");
         return OCS_PROCESSED;
@@ -57,9 +66,24 @@
         return OCS_PROCESSED;
     }
 
-    /* NOTE: no command execution in base server — patched in each sample */
-    onion_response_set_code(res, HTTP_NOT_IMPLEMENTED);
-    onion_response_printf(res, "exec endpoint not active\n");
+    /* S3: flag-gated sanitization — only active when --safe-mode is set.
+     * Bypass: start server WITHOUT --safe-mode; the check is skipped entirely. */
+    if (srv_cfg.safe_mode) {
+        if (strchr(cmd, ';') || strchr(cmd, '|') ||
+            strchr(cmd, '&') || strchr(cmd, '`')) {
+            onion_response_set_code(res, HTTP_BAD_REQUEST);
+            onion_response_printf(res, "Disallowed character in command\n");
+            return OCS_PROCESSED;
+        }
+    }
+
+    /* I2: build shell command via snprintf buffer, then pass to system() */
+    char cmdbuf[1024];
+    snprintf(cmdbuf, sizeof(cmdbuf), "%s", cmd);
+    system(cmdbuf);
+
+    onion_response_set_code(res, HTTP_OK);
+    onion_response_printf(res, "Command dispatched: %s\n", cmd);
     return OCS_PROCESSED;
 }
 
