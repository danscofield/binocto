@@ -38,13 +46,14 @@
         onion_listen_stop(g_onion);
 }
 
-/* ── /exec handler stub ─────────────────────────────────────────────────────── */
+/* ── /exec handler (C2 I2 S3) ───────────────────────────────────────────────── */
 static onion_connection_status exec_handler(void *data,
                                             onion_request  *req,
                                             onion_response *res)
 {
     (void)data;
-    if (!exec_mode) {
+    /* C2: check exec flag via struct */
